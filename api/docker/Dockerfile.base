# Custom base image for the Flask API service.
# Build: docker build -f docker/Dockerfile.base -t multi-service-api-base .
FROM python:3.12-slim

LABEL org.opencontainers.image.title="multi-service-api-base"
LABEL org.opencontainers.image.description="Custom Python base image for the API service"

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
