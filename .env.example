# Copy to .env and adjust values as needed.
# cp .env.example .env

# Docker Compose
COMPOSE_PROJECT_NAME=multi-service-app

# Nginx — host port for the public entry point
NGINX_HTTP_PORT=8080

# MongoDB — credentials are supplied via Docker secrets (see docker/secrets/)
MONGODB_DATABASE=app
MONGODB_USER=appuser

# Flask API — secret key is supplied via Docker secret (SECRET_KEY_FILE)
FLASK_ENV=development
FLASK_DEBUG=0
API_PORT=5000

# MongoDB — password supplied via Docker secret (MONGODB_PASSWORD_FILE)
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_AUTH_SOURCE=admin

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=60
